---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterPublishedPosts } from '../../lib/content.js';

export async function getStaticPaths() {
  const posts = filterPublishedPosts(await getCollection('blog'));

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — lome.dev`} description={post.data.description}>
  <main>
    <article>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <time datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString('en-GB')}</time>
      <Content />
    </article>
  </main>
</BaseLayout>
